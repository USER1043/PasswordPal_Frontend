# Copy this file to .env.local and fill in your values.
# .env.local is gitignored - never commit real secrets.

# URL of the PasswordPal backend. One value does two jobs:
#   - the app's API base URL (Vite), and
#   - the only host the Tauri app is allowed to call: src-tauri/build.rs turns it into
#     capabilities/backend-url.json (generated, gitignored) at build time.
# For local development: http://localhost:3000 (also the default when unset)
# For releases: set it as the VITE_BACKEND_URL GitHub Actions secret (the release build fails without it).
# Changing it needs a rebuild (restart `npm run tauri dev`).
VITE_BACKEND_URL=http://localhost:3000
